{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "templateParts": [
    {
      "name": "header",
      "title": "Header (Greek / Default)",
      "area": "header"
    },
    {
      "name": "header-en",
      "title": "Header (English)",
      "area": "header"
    },
    {
      "name": "header-ar",
      "title": "Header (Arabic)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (Greek / Default)",
      "area": "footer"
    },
    {
      "name": "footer-en",
      "title": "Footer (English)",
      "area": "footer"
    },
    {
      "name": "footer-ar",
      "title": "Footer (Arabic)",
      "area": "footer"
    }
  ],
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "940px",
      "wideSize": "940px"
    },
    "color": {
      "custom": true,
      "link": true,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#293e7a"
        },
        {
          "name": "Header Background",
          "slug": "header-bg",
          "color": "#000119"
        },
        {
          "name": "Footer Background",
          "slug": "footer-bg",
          "color": "#545454"
        },
        {
          "name": "Text Color",
          "slug": "text-default",
          "color": "#626262"
        },
        {
          "name": "Headings Color",
          "slug": "headings",
          "color": "#444444"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fontWeight": true,
      "fontStyle": true,
      "textTransform": true,
      "letterSpacing": true,
      "fontFamilies": [
        {
          "fontFamily": "Roboto, Arial, Tahoma, sans-serif",
          "name": "Body Font",
          "slug": "body"
        },
        {
          "fontFamily": "\"Patua One\", Arial, Tahoma, sans-serif",
          "name": "Headings Font",
          "slug": "headings"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "2.25rem"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "blocks": {
      "core/group": {
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        }
      },
      "core/image": {
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        }
      }
    }
  },
  "styles": {
    "spacing": {},
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color-text-default)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "var(--wp--preset--color--headings)"
        }
      }
    },
    "blocks": {
      "core/template-part/footer": {
        "color": {
          "background": "var(--wp--preset--color--footer-bg)",
          "text": "var(--wp--preset--color--white)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--white)"
            }
          }
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "0px",
            "right": "0px"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "400"
        }
      },
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "0.1875rem"
        }
      }
    }
  }
}