{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "940px",
      "wideSize": "940px"
    },
    "color": {
      "custom": true,
      "link": true,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#293e7a"
        },
        {
          "name": "Header Background",
          "slug": "header-bg",
          "color": "#000119"
        },
        {
          "name": "Footer Background",
          "slug": "footer-bg",
          "color": "#545454"
        },
        {
          "name": "Text Color",
          "slug": "text",
          "color": "#626262"
        },
        {
          "name": "Headings Color",
          "slug": "headings",
          "color": "#444444"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fontWeight": true,
      "fontStyle": true,
      "textTransform": true,
      "letterSpacing": true,
      "fontFamilies": [
        {
          "fontFamily": "Roboto, Arial, Tahoma, sans-serif",
          "name": "Body Font",
          "slug": "body"
        },
        {
          "fontFamily": "\"Patua One\", Arial, Tahoma, sans-serif",
          "name": "Headings Font",
          "slug": "headings"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "2.25rem"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "20",
          "size": "0.75rem"
        },
        {
          "name": "Medium",
          "slug": "30",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "40",
          "size": "2.5rem"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headings)"
        },
        "color": {
          "text": "#444444"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "400"
        }
      },
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "border": {
          "radius": "0.1875rem"
        }
      }
    }
  }
}