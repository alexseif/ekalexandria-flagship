{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#134479",
          "name": "EKA Primary Blue"
        },
        {
          "slug": "secondary",
          "color": "#c5a059",
          "name": "EKA Gold Accent"
        },
        {
          "slug": "dark",
          "color": "#1d2124",
          "name": "Dark Text"
        },
        {
          "slug": "light",
          "color": "#f8f9fa",
          "name": "Light Surface"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "muted",
          "color": "#6c757d",
          "name": "Muted Gray"
        }
      ],
      "gradients": [
        {
          "slug": "primary-to-secondary",
          "gradient": "linear-gradient(135deg, #134479 0%, #c5a059 100%)",
          "name": "Blue to Gold"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.75rem",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "2.5rem",
          "name": "Huge"
        }
      ],
      "customFontSize": true
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.5rem",
          "name": "10"
        },
        {
          "slug": "20",
          "size": "1rem",
          "name": "20"
        },
        {
          "slug": "30",
          "size": "1.5rem",
          "name": "30"
        },
        {
          "slug": "40",
          "size": "2rem",
          "name": "40"
        },
        {
          "slug": "50",
          "size": "3rem",
          "name": "50"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600"
        }
      }
    }
  }
}
