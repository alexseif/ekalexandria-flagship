{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "customTemplates": [
    {
      "name": "page-board",
      "postTypes": ["page"],
      "title": "Board of Directors"
    },
    {
      "name": "page-contact",
      "postTypes": ["page"],
      "title": "Contact Page"
    },
    { "name": "front-page-el", "postTypes": ["page"], "title": "Front Page (Greek)" },
    { "name": "page-establishment-el", "postTypes": ["page"], "title": "Establishment (Greek)" },
    { "name": "page-establishment-en", "postTypes": ["page"], "title": "Establishment (English)" },
    { "name": "page-establishment-ar", "postTypes": ["page"], "title": "Establishment (Arabic)" },
    { "name": "page-activities-el", "postTypes": ["page"], "title": "Activities (Greek)" },
    { "name": "page-activities-en", "postTypes": ["page"], "title": "Activities (English)" },
    { "name": "page-activities-ar", "postTypes": ["page"], "title": "Activities (Arabic)" },
    { "name": "page-services-el", "postTypes": ["page"], "title": "Services (Greek)" },
    { "name": "page-services-en", "postTypes": ["page"], "title": "Services (English)" },
    { "name": "page-services-ar", "postTypes": ["page"], "title": "Services (Arabic)" }
  ],
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "960px",
      "wideSize": "100%"
    },
    "color": {
      "palette": [
        { "slug": "primary", "color": "#293e7a", "name": "Primary (Deep Blue)" },
        { "slug": "secondary", "color": "#2275ac", "name": "Secondary (Hover Blue)" },
        { "slug": "foreground", "color": "#626262", "name": "Global Text" },
        { "slug": "headings", "color": "#444444", "name": "Headings" },
        { "slug": "background", "color": "#FFFFFF", "name": "Background" },
        { "slug": "surface", "color": "#fafafa", "name": "Surface" },
        { "slug": "contrast", "color": "#000000", "name": "Contrast" }
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "Roboto, Arial, Tahoma, sans-serif",
          "slug": "system-sans",
          "name": "Roboto (Base)"
        }
      ],
      "fontSizes": [
        { "slug": "base", "size": "1rem", "name": "Content Base" },
        { "slug": "menu", "size": "14px", "name": "Menu" },
        { "slug": "h1", "size": "25px", "name": "Heading 1" },
        { "slug": "h2", "size": "30px", "name": "Heading 2" },
        { "slug": "h3", "size": "25px", "name": "Heading 3" },
        { "slug": "h4", "size": "21px", "name": "Heading 4" },
        { "slug": "h5", "size": "15px", "name": "Heading 5" },
        { "slug": "h6", "size": "13px", "name": "Heading 6" }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "size": "10px", "slug": "small", "name": "Small" },
        { "size": "20px", "slug": "medium", "name": "Medium" },
        { "size": "30px", "slug": "large", "name": "Large" },
        { "size": "40px", "slug": "x-large", "name": "Extra Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h1)", "fontWeight": "normal" }
      },
      "h2": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h2)", "fontWeight": "normal" }
      },
      "h3": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h3)", "fontWeight": "normal" }
      },
      "h4": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h4)", "fontWeight": "normal" }
      },
      "h5": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h5)", "fontWeight": "normal" }
      },
      "h6": {
        "color": { "text": "var(--wp--preset--color--headings)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--h6)", "fontWeight": "normal" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--secondary)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": {
          "radius": "2px"
        }
      }
    },
    "blocks": {
      "core/cover": {
        "spacing": { "margin": { "top": "0" }, "padding": { "top": "0" } }
      },
      "core/group": {
        "spacing": { "margin": { "top": "0" }, "padding": { "top": "0" } }
      }
    }
  }
}
